aws_region               = "ap-northeast-2"
project_name             = "ubot"
github_repository        = "ureca-UBot/UBot-BE"
be_instance_id           = "i-REPLACE_WITH_EXISTING_BE_INSTANCE_ID"
be_instance_role_name    = "REPLACE_WITH_EXISTING_BE_INSTANCE_ROLE_NAME"

# Set this only when the AWS account already has a GitHub OIDC provider.
# github_oidc_provider_arn = "arn:aws:iam::ACCOUNT_ID:oidc-provider/token.actions.githubusercontent.com"

# Set these only if GitHub emits an immutable owner/repository ID based OIDC subject.
# github_publish_subject = "repo:ORG@OWNER_ID/REPO@REPO_ID:ref:refs/heads/develop"
# github_deploy_subject  = "repo:ORG@OWNER_ID/REPO@REPO_ID:environment:aws-poc"
