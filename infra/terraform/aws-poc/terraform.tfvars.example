be_instance_id = "i-REPLACE_WITH_BE_INSTANCE_ID"
fe_instance_id = "i-REPLACE_WITH_FE_INSTANCE_ID"
gpu_ami_id     = "ami-REPLACE_WITH_GPU_AMI"

# 스폿 ASG 대수. 0/0이면 스폿을 끔. 운영 중에는 1/3(1대 상시 + 사용률에 따라 2대까지)
gpu_min_size = 0
gpu_max_size = 0

# 온디맨드 GPU(평소 채팅·임베딩, #282 분석 중 14B 전용). 새 스폿 AMI와 PR #282 반영 뒤에 true
# gpu_on_demand_enabled = true

# AMI를 새로 만들 때만 true
# gpu_builder_enabled = true

