# AWS GPU(g6.xlarge, NVIDIA L4 23GB)용 vLLM 설정. 빌더가 /opt/ubot-gpu/.env로 써서 AMI에 들어감
# 서비스 정의는 infra/llm/docker-compose.yml을 그대로 쓰고, 값만 로컬(infra/llm/.env.example)과 따로 둠
# 서빙 이름과 포트는 BE의 LLM_MODEL·EMBEDDING_MODEL, NLB 리스너와 같아야 함

# 공개 모델만 써서 비워 둠
HF_TOKEN=

VLLM_IMAGE=vllm/vllm-openai:v0.31.0

LLM_HF_MODEL=RedHatAI/Qwen3-4B-Instruct-2507-quantized.w4a16
LLM_SERVED_MODEL_NAME=ubot-chat
LLM_PORT=8000
LLM_MAX_MODEL_LEN=4096
VLLM_GPU_MEMORY_UTILIZATION=0.6
VLLM_TOOL_CALL_PARSER=hermes
VLLM_ENABLE_THINKING=false

# 모델을 바꾸면 EMBEDDING_PROFILE_VERSION과 FAQ 벡터 재생성을 함께 검토해야 함
EMBEDDING_HF_MODEL=BAAI/bge-m3
EMBEDDING_SERVED_MODEL_NAME=ubot-embedding
EMBEDDING_PORT=8001
EMBEDDING_MAX_MODEL_LEN=8192
EMBEDDING_DTYPE=float16
# 채팅 0.6과 합쳐 0.9. 두 vLLM이 한 GPU를 나눠 씀
VLLM_EMBEDDING_GPU_MEMORY_UTILIZATION=0.3
