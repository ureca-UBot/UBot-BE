# AWS PoC BE EC2의 ~/ubot-api/.env 견본입니다. 루트 .env.example(develop)의 변수를 BE 서버 기준으로 옮겼습니다.
# CI가 이 파일로 Compose 구성을 검사합니다. replace-on-server 값은 서버에서만 바꾸고 Git에 실제 값을 넣지 않습니다.
# Compose(env_file)와 Spring이 같은 파일을 읽으므로 따옴표와 값 뒤 주석을 쓰지 않습니다.

# ── Spring Profile ─────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
# docker-compose.api.yml·worker.yml이 서비스별로 api·worker로 덮어씁니다.
APP_ROLE=api
# 모델 서버는 GPU EC2에서 따로 운영합니다(BE CD는 모델 서버를 띄우지 않음).
AI_RUNTIME_MANAGED=false


# ── AI 실행 환경 ──────────────────────────────────────────────
AI_MODE=vllm
# AI_MODE=custom일 때만 씁니다. vllm 모드에서 값이 있으면 기동하지 않습니다.
# AI_CHAT_ENGINE=vllm
# AI_EMBEDDING_ENGINE=vllm
# 임베딩 모델을 바꾸면 이름이 같아도 올리고 백필합니다.
EMBEDDING_PROFILE_VERSION=1


# ── State EC2 (PostgreSQL·Redis) ──────────────────────────────
# 예시 IP입니다. 서버에서는 State EC2의 사설 IP로 바꿉니다.
POSTGRES_HOST=10.0.0.10
POSTGRES_PORT=5432
POSTGRES_DB=ubot
POSTGRES_USER=ubot
POSTGRES_PASSWORD=replace-on-server

REDIS_HOST=10.0.0.10
REDIS_PORT=6379


# ── GPU (AI NLB) ──────────────────────────────────────────────
# Compose가 LLM_BASE_URL=http://NLB_DNS:8000/v1, EMBEDDING_BASE_URL=http://NLB_DNS:8001/v1로 만듭니다.
# 여기에 LLM_BASE_URL·EMBEDDING_BASE_URL을 적어도 Compose 값이 우선합니다.
NLB_DNS=example.invalid

# GPU vLLM의 served model name과 같아야 합니다.
LLM_MODEL=ubot-chat
EMBEDDING_MODEL=ubot-embedding

# Backend → vLLM 호출 제한 시간
LLM_CONNECT_TIMEOUT=3s
LLM_READ_TIMEOUT=120s
EMBEDDING_CONNECT_TIMEOUT=3s
EMBEDDING_READ_TIMEOUT=30s
# 프로세스 하나가 모델 서버에 동시에 보내는 호출 수의 상한. 비우면 CHAT_WORKER_CONCURRENCY와 같습니다.
# LLM_MAX_CONCURRENT=2

# Ollama는 쓰지 않지만 prod 프로필이 이 키를 읽습니다.
OLLAMA_BASE_URL=
OLLAMA_EMBEDDING_MODEL=bge-m3:567m
OLLAMA_CONNECT_TIMEOUT=3s
OLLAMA_READ_TIMEOUT=10s


# ── 인증 (JWT) ────────────────────────────────────────────────
# Base64로 인코딩된 32바이트 이상의 랜덤 값(openssl rand -base64 48)
JWT_SECRET=replace-on-server-with-a-long-random-value
JWT_ACCESS_TOKEN_EXPIRATION_MILLIS=600000
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=14

# FE가 같은 origin의 /api로 프록시하면 비워 둡니다. 다른 origin에서 호출할 때만 정확한 origin을 적습니다.
CORS_ALLOWED_ORIGINS=


# ── 채팅 ──────────────────────────────────────────────────────
CHAT_MAX_ATTEMPTS=3
CHAT_TOP_K=3
CHAT_CONFIDENCE_THRESHOLD=0.75
CHAT_STORE_RADIUS_KM=3.0
CHAT_STORE_LIMIT=5


# ── 답변 Worker ───────────────────────────────────────────────
# GPU 1대당 2건 기준(온디맨드 1 + 스폿 최대 2 = 6). NLB는 연결 단위로 나누므로 동시 처리가 적으면 한 GPU로 몰립니다.
CHAT_WORKER_CONCURRENCY=6
CHAT_WORKER_READ_BLOCK=2s
# 지정하지 않으면 컨테이너 호스트 이름을 씁니다. 빈 값으로 두면 기동하지 않습니다.
# CHAT_WORKER_CONSUMER_NAME=worker-1
CHAT_WORKER_MAX_QUEUE_WAIT=10m
CHAT_WORKER_REPUBLISH_AFTER=30s
CHAT_WORKER_HEARTBEAT_TIMEOUT=1m
CHAT_WORKER_RECLAIM_IDLE=5m
CHAT_WORKER_MAX_DELIVERIES=3
CHAT_WORKER_RECOVERY_INTERVAL=15s
CHAT_WORKER_RESULT_TTL=24h
CHAT_WORKER_EXECUTION_TIMEOUT=180s
# Compose의 stop_grace_period(35s)보다 짧아야 합니다.
CHAT_WORKER_SHUTDOWN_WAIT=20s
# 회원 접수(질문·재시도·재검색)의 사용자 ID별 제한. Nginx의 토큰별 제한과 달리 토큰을 재발급해도 이어집니다.
CHAT_USER_RATE_LIMIT_ENABLED=true
CHAT_USER_RATE_LIMIT_MAX=30
CHAT_USER_RATE_LIMIT_WINDOW=60s
# 프로세스 하나의 DB 연결 수. API·Worker 합이 PostgreSQL max_connections보다 작아야 합니다.
DB_POOL_MAX_SIZE=10
SCHEDULER_POOL_SIZE=4


# ── 상담 ──────────────────────────────────────────────────────
# BE CD가 V39 적용 후 상담 안전 문장 색인을 준비합니다.
COUNSEL_ENABLED=true
COUNSEL_SEED_ON_START=false
COUNSEL_EMBEDDING_TRANSPORT=worker
COUNSEL_EMBEDDING_WORKER_ENABLED=true
COUNSEL_GUARD_MODEL=ubot-embedding
COUNSEL_GUARD_PROFILE=insult-v1
COUNSEL_BLOCK_THRESHOLD=0.95


# ── FAQ 검색 ──────────────────────────────────────────────────
FAQ_SENTENCE_SIMILARITY_THRESHOLD=0.6

# Worker는 Compose가 FAQ_CACHE_ENABLED=true로 덮어씁니다(기존 서버 설정 유지).
FAQ_CACHE_ENABLED=false
FAQ_CACHE_MIN_SIMILARITY=0.95
FAQ_CACHE_MIN_MARGIN=0.15

# Reranker는 PoC GPU에서 기본으로 띄우지 않습니다. 켜려면 FAQ_RERANK_BASE_URL을 GPU 주소로 바꿉니다.
FAQ_RERANK_ENABLED=false
FAQ_RERANK_CANDIDATE_K=10
FAQ_RERANK_MODEL=ubot-reranker
FAQ_RERANK_BASE_URL=http://localhost:8002
FAQ_RERANK_CONNECT_TIMEOUT=500ms
FAQ_RERANK_READ_TIMEOUT=1500ms
FAQ_RERANK_FALLBACK_ENABLED=true
FAQ_RERANK_MAX_CONCURRENT=32
FAQ_RERANK_FAILURE_THRESHOLD=5
FAQ_RERANK_FAILURE_COOLDOWN=10s


# ── 미응답 질문 ───────────────────────────────────────────────
UNANSWERED_GROUP_THRESHOLD=0.6
OUTBOX_POLL_DELAY_MS=2000
UNANSWERED_NAMING_INTERVAL_MINUTES=5


# ── 외부 API ──────────────────────────────────────────────────
KAKAO_REST_API_KEY=replace-on-server


# ── 랭킹 ──────────────────────────────────────────────────────
RANKING_WINDOW_MINUTES=20
RANKING_SIZE=5
REFRESH_SCHEDULER_INTERVAL_MINUTES=1
MIN_CURRENT_SEARCH_COUNT=10
BASELINE_PERIOD_DAYS=2
BASELINE_MIN_SAMPLE_COUNT=10
TREND_RATIO_THRESHOLD=10


# ── FAQ 모니터링 ──────────────────────────────────────────────
FAQ_AI_REVIEW_MAX_DUPLICATE_CANDIDATES=5
FAQ_AI_REVIEW_MAX_QUESTIONS_PER_DUPLICATE_CANDIDATE=20
FAQ_AI_REVIEW_MAX_DISPLAYED_QUESTIONS_PER_DUPLICATE_CANDIDATE=5
FAQ_AI_REVIEW_MAX_LOW_RAG_QUALITY_QUESTIONS=20
FAQ_AI_REVIEW_MAX_DISPLAYED_QUESTIONS_FOR_LOW_RAG_QUALITY=5
FAQ_AI_REVIEW_MAX_LLM_QUEUE_WAIT_MILLIS=5000
FAQ_IMPROVEMENT_LOW_SIMILARITY_THRESHOLD=0.76
FAQ_IMPROVEMENT_LOW_GAP_RATE_THRESHOLD=0.40
FAQ_IMPROVEMENT_LOW_GAP_THRESHOLD=0.07
FAQ_IMPROVEMENT_UNUSED_MINUTES=10080
FAQ_IMPROVEMENT_MIN_TOP_K_SAMPLES=10
FAQ_IMPROVEMENT_MIN_TOP1_SAMPLES=10


# ── Prometheus ────────────────────────────────────────────────
# BE EC2의 docker-compose.monitoring.yml이 Prometheus와 PostgreSQL·Redis exporter, cAdvisor를 띄웁니다.
# API의 PROMETHEUS_BASE_URL은 Compose가 http://prometheus:9090으로 정합니다(여기 값보다 우선).
# Prometheus 화면은 서버의 127.0.0.1:PROMETHEUS_PORT에만 열리므로 SSM 포트 포워딩으로 봅니다.
PROMETHEUS_PORT=19090
PROMETHEUS_RETENTION_TIME=7d
PROMETHEUS_RETENTION_SIZE=2GB
PROMETHEUS_BASE_URL=http://prometheus:9090
PROMETHEUS_CONNECT_TIMEOUT=2s
PROMETHEUS_READ_TIMEOUT=10s


# ── BE Nginx ──────────────────────────────────────────────────
# real_ip를 신뢰할 FE EC2의 사설 IP. 틀리면 게스트 요청이 FE IP 하나의 속도 제한을 함께 씁니다.
FE_PRIVATE_IP=10.20.0.10
# 게스트(Bearer 없음) 채팅 요청: 클라이언트 IP별 제한
CHAT_GUEST_RATE_LIMIT_RATE=30r/m
CHAT_GUEST_RATE_LIMIT_BURST=10
# 회원(Bearer 있음) 채팅 요청: 접근 토큰별 제한. 통신사 NAT·같은 건물처럼 IP를 함께 쓰는 회원끼리 나누지 않습니다.
CHAT_MEMBER_RATE_LIMIT_RATE=30r/m
CHAT_MEMBER_RATE_LIMIT_BURST=10


# ── BE 이미지 ─────────────────────────────────────────────────
# 서버에서 Compose를 손으로 실행할 때 쓰는 값입니다. CD는 배포하는 digest를 직접 넘기므로 이 값을 쓰지 않습니다.
BACKEND_IMAGE=example.invalid/ubot-be@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa


# ── BE EC2에서 쓰지 않는 루트 .env.example 변수 ────────────────
# GPU 서버(vLLM)용: LLM_PORT, LLM_HF_MODEL, LLM_SERVED_MODEL_NAME, LLM_MAX_MODEL_LEN, VLLM_GPU_MEMORY_UTILIZATION,
#   VLLM_TOOL_CALL_PARSER, VLLM_ENABLE_THINKING, EMBEDDING_PORT, EMBEDDING_HF_MODEL, EMBEDDING_SERVED_MODEL_NAME,
#   EMBEDDING_MAX_MODEL_LEN, EMBEDDING_DTYPE, VLLM_EMBEDDING_GPU_MEMORY_UTILIZATION, RERANKER_PORT,
#   VLLM_RERANKER_GPU_MEMORY_UTILIZATION, HF_TOKEN, VLLM_IMAGE
# 로컬 Compose용: OLLAMA_PORT, OLLAMA_GPU, OLLAMA_CHAT_MODEL, WEB_PORT, UBOT_FE_DIST
# Compose가 NLB_DNS로 만드는 값: LLM_BASE_URL, EMBEDDING_BASE_URL
