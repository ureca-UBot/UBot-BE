# ── Hugging Face ──────────────────────────────────────────────
# 공개 모델만 사용하면 비워둘 수 있습니다.
HF_TOKEN=


# ── Images ────────────────────────────────────────────────────
VLLM_IMAGE=vllm/vllm-openai:v0.31.0
SGLANG_IMAGE=lmsysorg/sglang:latest-runtime


# ── Chat Model Runtime ────────────────────────────────────────
# 실제 Hugging Face에서 로딩할 모델
LLM_HF_MODEL=Qwen/Qwen3-4B-AWQ

# OpenAI-compatible API에 노출할 모델 이름
LLM_SERVED_MODEL_NAME=ubot-chat

# 호스트에 노출할 포트
LLM_PORT=8000

# 최대 context length
LLM_MAX_MODEL_LEN=4096

# vLLM GPU 메모리 사용 비율
VLLM_GPU_MEMORY_UTILIZATION=0.6

# Tool Calling
# 사용하는 모델의 tool-call 형식과 맞아야 합니다.
VLLM_TOOL_CALL_PARSER=hermes

# Qwen3 Thinking Mode 기본값
VLLM_ENABLE_THINKING=false


# ── Embedding Model Runtime ───────────────────────────────────
# 실제 Hugging Face에서 로딩할 임베딩 모델
EMBEDDING_HF_MODEL=BAAI/bge-m3

# OpenAI-compatible API에 노출할 모델 이름
EMBEDDING_SERVED_MODEL_NAME=ubot-embedding

# 호스트에 노출할 포트
EMBEDDING_PORT=8001

# 최대 context length
EMBEDDING_MAX_MODEL_LEN=8192

EMBEDDING_DTYPE=float16

# vLLM Embedding GPU 메모리 사용 비율
VLLM_EMBEDDING_GPU_MEMORY_UTILIZATION=0.2


# ── SGLang Runtime ────────────────────────────────────────────
# 벤치마크/대체 엔진용
SGLANG_MEM_FRACTION_STATIC=0.6