# ── Spring Profile ─────────────────────────────────────────────
# 로컬 개발 기본값입니다.
# Docker/배포에서는 env_file을 통해 실제 환경변수로 주입합니다.
# 운영 서버에서는 prod로 설정합니다.
SPRING_PROFILES_ACTIVE=local


# ── AI 실행 환경 ──────────────────────────────────────────────
# 일반적으로 ollama 또는 vllm 중 하나를 선택합니다.
# 이 경우 채팅과 임베딩은 같은 엔진을 사용합니다.
AI_MODE=ollama
# AI_MODE=vllm

# 채팅과 임베딩 엔진을 다르게 사용해야 하는 특수한 경우에만 custom을 사용합니다.
# AI_MODE=custom
# AI_CHAT_ENGINE=vllm
# AI_EMBEDDING_ENGINE=ollama


# ── PostgreSQL ────────────────────────────────────────────────
# 로컬에서는 호스트 포트를 사용합니다.
# Docker 내부에서 Backend를 실행할 때는 Compose에서 postgres:5432로 덮어쓸 수 있습니다.
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=ubot
POSTGRES_USER=ubot
POSTGRES_PASSWORD=change-me


# ── Redis ─────────────────────────────────────────────────────
# 로컬에서는 호스트 포트를 사용합니다.
# Docker 내부에서 Backend를 실행할 때는 Compose에서 redis:6379로 덮어쓸 수 있습니다.
REDIS_HOST=localhost
REDIS_PORT=16379


# ── Ollama ────────────────────────────────────────────────────
# AI_MODE=ollama이거나 custom에서 ollama를 선택할 때 사용합니다.

# 호스트에 노출할 Ollama 포트
OLLAMA_PORT=11435

# Backend가 Ollama를 호출할 주소
OLLAMA_BASE_URL=http://localhost:11435

# Ollama에서 사용할 모델
# 채팅 모델은 프로젝트에서 사용할 모델 태그를 지정합니다.
OLLAMA_CHAT_MODEL=
OLLAMA_EMBEDDING_MODEL=bge-m3:567m

# Ollama 임베딩 호출 제한 시간
OLLAMA_CONNECT_TIMEOUT=3s
OLLAMA_READ_TIMEOUT=10s


# ── vLLM / OpenAI-compatible API ──────────────────────────────
# AI_MODE=vllm이거나 custom에서 vllm을 선택할 때 사용합니다.


# ── vLLM Chat API ─────────────────────────────────────────────
# Backend가 호출할 OpenAI-compatible API 주소입니다.
# /v1까지 포함합니다.
LLM_BASE_URL=http://localhost:8000/v1

# Backend가 API 요청의 model 필드에 넣는 served model name입니다.
LLM_MODEL=ubot-chat

# 호스트에 노출할 vLLM Chat API 포트
LLM_PORT=8000

# vLLM이 실제 Hugging Face에서 불러올 모델입니다.
LLM_HF_MODEL=Qwen/Qwen3-4B-AWQ

# vLLM이 API에 노출할 served model name입니다.
# Backend의 LLM_MODEL과 동일해야 합니다.
LLM_SERVED_MODEL_NAME=ubot-chat

# 최대 context length
LLM_MAX_MODEL_LEN=4096

# GPU 메모리 사용 비율
VLLM_GPU_MEMORY_UTILIZATION=0.6

# Tool Calling
VLLM_TOOL_CALL_PARSER=hermes

# Qwen3 Thinking Mode 기본값
VLLM_ENABLE_THINKING=false


# ── vLLM Embedding API ────────────────────────────────────────
# Backend가 호출할 OpenAI-compatible Embedding API 주소입니다.
# /v1까지 포함합니다.
EMBEDDING_BASE_URL=http://localhost:8001/v1

# Backend가 embeddings 요청의 model 필드에 넣는 served model name입니다.
EMBEDDING_MODEL=ubot-embedding

# 호스트에 노출할 Embedding API 포트
EMBEDDING_PORT=8001

# vLLM이 실제 Hugging Face에서 불러올 임베딩 모델입니다.
EMBEDDING_HF_MODEL=BAAI/bge-m3

# vLLM이 API에 노출할 served model name입니다.
# Backend의 EMBEDDING_MODEL과 동일해야 합니다.
EMBEDDING_SERVED_MODEL_NAME=ubot-embedding

# 임베딩 모델 최대 context length
EMBEDDING_MAX_MODEL_LEN=8192

# 임베딩 모델 dtype
EMBEDDING_DTYPE=float16

# 임베딩 서버 GPU 메모리 사용 비율
VLLM_EMBEDDING_GPU_MEMORY_UTILIZATION=0.2

# Backend → vLLM Embedding HTTP timeout
EMBEDDING_CONNECT_TIMEOUT=3s
EMBEDDING_READ_TIMEOUT=30s


# ── Hugging Face / vLLM Runtime ───────────────────────────────
# 공개 모델만 사용할 경우 비워둘 수 있습니다.
HF_TOKEN=

# 검증된 vLLM 이미지 버전을 사용합니다.
VLLM_IMAGE=vllm/vllm-openai:v0.31.0


# ── 답변 생성 공통 ────────────────────────────────────────────
# Ollama / vLLM 채팅 호출에 공통으로 사용하는 제한 시간입니다.
LLM_CONNECT_TIMEOUT=3s
LLM_READ_TIMEOUT=120s


# ── 인증 (JWT) ────────────────────────────────────────────────
# Base64로 인코딩된 32바이트 이상의 랜덤 값을 사용합니다.
# 예:
# StCQJn4BZq6ZMNMlf0WUM8Py0AW8c3jLTr7nLSqiieo
JWT_SECRET=<base64-encoded-random-secret-at-least-32-bytes>

JWT_ACCESS_TOKEN_EXPIRATION_MILLIS=600000
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=14


# ── 채팅 ──────────────────────────────────────────────────────
CHAT_MAX_ATTEMPTS=3
CHAT_TOP_K=3
CHAT_CONFIDENCE_THRESHOLD=0.75
CHAT_RESPONSE_TIMEOUT_MILLIS=180000

# 미응답 질문을 같은 그룹으로 묶을 최소 코사인 유사도
UNANSWERED_GROUP_THRESHOLD=0.6

# 채팅 매장 조회
CHAT_STORE_RADIUS_KM=3.0
CHAT_STORE_LIMIT=5


# ── 외부 API ──────────────────────────────────────────────────
KAKAO_REST_API_KEY=


# ── 랭킹 ──────────────────────────────────────────────────────
RANKING_WINDOW_MINUTES=60
RANKING_SIZE=5
REFRESH_SCHEDULER_INTERVAL_MINUTES=5
MIN_CURRENT_SEARCH_COUNT=20
BASELINE_PERIOD_DAYS=7
BASELINE_MIN_SAMPLE_COUNT=20
TREND_RATIO_THRESHOLD=20


# ── Backend Image ─────────────────────────────────────────────
# 로컬 Compose 기본 이미지입니다.
# CD에서는 커밋 SHA가 붙은 이미지로 덮어씁니다.
BACKEND_IMAGE=ubot-be:local


# ── Nginx ─────────────────────────────────────────────────────
# /chat/ 게스트 요청 속도 제한
# Authorization Bearer 헤더가 없는 요청에 적용합니다.
CHAT_GUEST_RATE_LIMIT_RATE=30r/m
CHAT_GUEST_RATE_LIMIT_BURST=10

# 로컬에서 프론트와 백엔드를 같은 Nginx로 제공할 때 사용합니다.
WEB_PORT=8088
UBOT_FE_DIST=../UBot-FE/dist


# ── Prometheus ────────────────────────────────────────────────
PROMETHEUS_PORT=19090