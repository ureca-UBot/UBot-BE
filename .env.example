# ── Spring Profile ─────────────────────────────────────────────
# 로컬 개발 기본값입니다.
# Docker/배포에서는 env_file을 통해 실제 환경변수로 주입합니다.
# 운영 서버에서는 prod로 설정합니다.
SPRING_PROFILES_ACTIVE=local
AI_RUNTIME_MANAGED=true

# ── AI 실행 환경 ──────────────────────────────────────────────
# 일반적으로 ollama 또는 vllm 중 하나를 선택합니다.
# 이 경우 채팅과 임베딩은 같은 엔진을 사용합니다.
AI_MODE=ollama
# AI_MODE=vllm
EMBEDDING_PROFILE_VERSION=1

# 채팅과 임베딩 엔진을 다르게 사용해야 하는 특수한 경우에만 custom을 사용합니다.
# AI_MODE=custom
# AI_CHAT_ENGINE=vllm
# AI_EMBEDDING_ENGINE=ollama


# ── PostgreSQL ────────────────────────────────────────────────
# 로컬에서는 호스트 포트를 사용합니다.
# Docker 내부에서 Backend를 실행할 때는 Compose에서 postgres:5432로 덮어쓸 수 있습니다.
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=ubot
POSTGRES_USER=ubot
POSTGRES_PASSWORD=change-me


# ── Redis ─────────────────────────────────────────────────────
# 로컬에서는 호스트 포트를 사용합니다.
# Docker 내부에서 Backend를 실행할 때는 Compose에서 redis:6379로 덮어쓸 수 있습니다.
REDIS_HOST=localhost
REDIS_PORT=16379


# ── Ollama ────────────────────────────────────────────────────
# AI_MODE=ollama이거나 custom에서 ollama를 선택할 때 사용합니다.

# 호스트에 노출할 Ollama 포트
OLLAMA_PORT=11435

# true면 tools/ubot.ps1 up이 Ollama 컨테이너에 NVIDIA GPU를 연결합니다(docker-compose.ollama.gpu.yml).
# NVIDIA GPU와 Docker GPU 지원(Docker Desktop은 WSL2, Linux는 NVIDIA Container Toolkit)이 있어야 합니다. 없으면 false로 둡니다.
OLLAMA_GPU=false

# Backend가 Ollama를 호출할 주소
OLLAMA_BASE_URL=http://localhost:11435

# Ollama에서 사용할 모델
# 채팅 모델은 LLM_Test model_test_v5로 프롬프트와 함께 검증한 Qwen3-4B-Instruct-2507 Q4_K_M입니다.
# (ollama list의 ID 0edcdef34593). 다른 모델로 바꾸면 프롬프트 검증 결과가 그대로 적용되지 않습니다.
OLLAMA_CHAT_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_EMBEDDING_MODEL=bge-m3:567m

# Ollama 임베딩 호출 제한 시간
OLLAMA_CONNECT_TIMEOUT=3s
OLLAMA_READ_TIMEOUT=10s


# ── vLLM / OpenAI-compatible API ──────────────────────────────
# AI_MODE=vllm이거나 custom에서 vllm을 선택할 때 사용합니다.


# ── vLLM Chat API ─────────────────────────────────────────────
# Backend가 호출할 OpenAI-compatible API 주소입니다.
# /v1까지 포함합니다.
LLM_BASE_URL=http://localhost:8000/v1

# Backend가 API 요청의 model 필드에 넣는 served model name입니다.
LLM_MODEL=ubot-chat

# 호스트에 노출할 vLLM Chat API 포트
LLM_PORT=8000

# vLLM이 실제 Hugging Face에서 불러올 모델입니다.
# Ollama 기본 모델과 같은 Qwen3-4B-Instruct-2507을 Red Hat이 GPTQ W4A16(compressed-tensors)으로 양자화한 모델입니다.
# 추론 모드가 없는 Instruct 모델이라 VLLM_ENABLE_THINKING 값과 관계없이 생각 과정을 출력하지 않습니다.
LLM_HF_MODEL=RedHatAI/Qwen3-4B-Instruct-2507-quantized.w4a16

# vLLM이 API에 노출할 served model name입니다.
# Backend의 LLM_MODEL과 동일해야 합니다.
LLM_SERVED_MODEL_NAME=ubot-chat

# 최대 context length
LLM_MAX_MODEL_LEN=4096

# GPU 메모리 사용 비율
VLLM_GPU_MEMORY_UTILIZATION=0.6

# Tool Calling
VLLM_TOOL_CALL_PARSER=hermes

# Qwen3 Thinking Mode 기본값
VLLM_ENABLE_THINKING=false


# ── vLLM Embedding API ────────────────────────────────────────
# Backend가 호출할 OpenAI-compatible Embedding API 주소입니다.
# /v1까지 포함합니다.
EMBEDDING_BASE_URL=http://localhost:8001/v1

# Backend가 embeddings 요청의 model 필드에 넣는 served model name입니다.
EMBEDDING_MODEL=ubot-embedding

# 호스트에 노출할 Embedding API 포트
EMBEDDING_PORT=8001

# vLLM이 실제 Hugging Face에서 불러올 임베딩 모델입니다.
EMBEDDING_HF_MODEL=BAAI/bge-m3

# vLLM이 API에 노출할 served model name입니다.
# Backend의 EMBEDDING_MODEL과 동일해야 합니다.
EMBEDDING_SERVED_MODEL_NAME=ubot-embedding

# 임베딩 모델 최대 context length
EMBEDDING_MAX_MODEL_LEN=8192

# 임베딩 모델 dtype
EMBEDDING_DTYPE=float16

# 임베딩 서버 GPU 메모리 사용 비율
VLLM_EMBEDDING_GPU_MEMORY_UTILIZATION=0.2

# Reranker 서버는 기본으로 뜨지 않습니다. docker compose --profile reranker 로 띄울 때만 씁니다.
RERANKER_PORT=8002
VLLM_RERANKER_GPU_MEMORY_UTILIZATION=0.2

# Backend → vLLM Embedding HTTP timeout
EMBEDDING_CONNECT_TIMEOUT=3s
EMBEDDING_READ_TIMEOUT=30s


# ── Hugging Face / vLLM Runtime ───────────────────────────────
# 공개 모델만 사용할 경우 비워둘 수 있습니다.
HF_TOKEN=

# 검증된 vLLM 이미지 버전을 사용합니다.
VLLM_IMAGE=vllm/vllm-openai:v0.31.0


# ── 답변 생성 공통 ────────────────────────────────────────────
# Ollama / vLLM 채팅 호출에 공통으로 사용하는 제한 시간입니다.
LLM_CONNECT_TIMEOUT=3s
LLM_READ_TIMEOUT=120s
# 프로세스 하나가 모델 서버에 동시에 보내는 호출 수의 상한. 비우면 CHAT_WORKER_CONCURRENCY와 같습니다.
# 시간 초과로 끊긴 호출이 아직 끝나지 않았어도 이 상한 안에서만 새 호출을 보냅니다.
# LLM_MAX_CONCURRENT=4


# ── 인증 (JWT) ────────────────────────────────────────────────
# Base64로 인코딩된 32바이트 이상의 랜덤 값을 사용합니다.
# 예:
# StCQJn4BZq6ZMNMlf0WUM8Py0AW8c3jLTr7nLSqiieo
JWT_SECRET=<base64-encoded-random-secret-at-least-32-bytes>

JWT_ACCESS_TOKEN_EXPIRATION_MILLIS=600000
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=14

# 다른 주소에서 API를 호출할 때 허용할 origin(쉼표로 구분). 비워 두면 같은 origin만 허용합니다.
# 예: https://ureca-ubot.github.io
CORS_ALLOWED_ORIGINS=


# ── 채팅 ──────────────────────────────────────────────────────
CHAT_MAX_ATTEMPTS=3
CHAT_TOP_K=3
CHAT_CONFIDENCE_THRESHOLD=0.75

# ── 답변 Worker ───────────────────────────────────────────────
# 질문은 접수만 하고(202), Redis Streams(chat:jobs)로 Worker에 넘깁니다. Worker는 답변을 만든 뒤 DB에 기록하고 ACK합니다.
# APP_ROLE: all(접수+Worker, 로컬 기본), api(접수·조회만), worker(Worker만, HTTP는 /actuator만). 배포 Compose는 서비스별로 따로 정합니다.
APP_ROLE=all
# Worker 하나가 동시에 만드는 답변 수. 모델 서버 처리량을 보고 정합니다.
CHAT_WORKER_CONCURRENCY=4
# 새 메시지가 없을 때 다음 읽기까지 쉬는 시간(슬롯을 점유하지 않음)
CHAT_WORKER_READ_BLOCK=2s
# 스트림 그룹 안의 Worker 이름. 지정하지 않으면 호스트 이름을 씁니다(빈 값으로 두면 기동하지 않습니다). Worker를 여러 개 띄우면 서로 달라야 합니다.
# CHAT_WORKER_CONSUMER_NAME=worker-1
# 접수 뒤 이 시간 안에 시작하지 못한 질문은 실패(CHAT-016)로 끝냅니다.
CHAT_WORKER_MAX_QUEUE_WAIT=10m
# 이 시간 넘게 대기 중인데 발행 기록이 없는 질문(발행 실패, Redis 데이터 유실)은 메시지를 다시 발행합니다. 대기 한도보다 짧아야 합니다.
CHAT_WORKER_REPUBLISH_AFTER=30s
# 실행 중인 질문의 DB heartbeat가 이 시간 넘게 없으면 그 Worker가 죽은 것으로 보고 다른 Worker가 가져갑니다.
# heartbeat는 이 시간의 3분의 1(최대 15초)마다 갱신합니다. 아래 RECLAIM_IDLE보다 길 수 없습니다.
CHAT_WORKER_HEARTBEAT_TIMEOUT=1m
# 이 시간 넘게 ACK되지 않은 메시지는 작업 상태를 보지 않고 가져가기를 시도합니다(마지막 안전망).
CHAT_WORKER_RECLAIM_IDLE=5m
# 한 메시지를 Worker에 전달하는 최대 횟수. 다 쓰면 실패(CHAT-015)로 끝냅니다.
CHAT_WORKER_MAX_DELIVERIES=3
CHAT_WORKER_RECOVERY_INTERVAL=15s
# 결과 캐시 TTL. 원본은 DB에 있으므로 만료 뒤에도 지도까지 조회할 수 있습니다.
CHAT_WORKER_RESULT_TTL=24h
# 임베딩·도구·LLM을 포함한 작업 실행 제한. 초과하면 CHAT-016으로 끝내고 늦은 결과는 버립니다.
CHAT_WORKER_EXECUTION_TIMEOUT=180s
# Worker를 멈출 때 실행 중인 질문이 끝나기를 기다리는 시간. 넘기면 질문을 대기열에 돌려놓고 다른 Worker가 다시 만듭니다.
# 컨테이너 종료 유예 시간(docker-compose.deploy.yml의 stop_grace_period 35s, ECS stopTimeout 등)보다 짧아야 합니다.
CHAT_WORKER_SHUTDOWN_WAIT=20s
# 프로세스 하나의 DB 연결 수. API와 Worker를 합쳐 PostgreSQL max_connections보다 작아야 합니다.
DB_POOL_MAX_SIZE=10

# FAQ 검색 벡터 유형: QUESTION(질문만), QUESTION_ANSWER(질문+답변)
FAQ_SEARCH_VECTOR_TYPE=QUESTION

# 공식 FAQ 답변 반환: 검증된 GENERAL FAQ만 cacheable=true로 승인한 뒤 켭니다.
# 유사도·서로 다른 FAQ 간 점수 차이는 실험 시작값이며 의미 일치를 보장하지 않습니다.
FAQ_CACHE_ENABLED=false
FAQ_CACHE_MIN_SIMILARITY=0.95
FAQ_CACHE_MIN_MARGIN=0.15

# 벡터 검색 후보를 Reranker(bge-reranker-v2-m3)로 다시 정렬할지 여부. 기본값은 꺼짐이고, 꺼 두면 Reranker 서버가 없어도 됩니다.
# 켜면 후보를 FAQ_RERANK_CANDIDATE_K개 가져와 Reranker 점수 순으로 다시 놓습니다.
# LLM에 전달할지는 켜든 끄든 코사인 유사도(CHAT_CONFIDENCE_THRESHOLD)로만 정합니다. Reranker 점수는 순서에만 씁니다.
# Reranker가 실패하거나 제한 시간을 넘으면 이미 받아 둔 벡터 검색 상위 CHAT_TOP_K개로 답합니다.
FAQ_RERANK_ENABLED=false
FAQ_RERANK_CANDIDATE_K=10
FAQ_RERANK_MODEL=ubot-reranker
FAQ_RERANK_BASE_URL=http://localhost:8002
FAQ_RERANK_CONNECT_TIMEOUT=500ms
FAQ_RERANK_READ_TIMEOUT=1500ms
FAQ_RERANK_FALLBACK_ENABLED=true
# 동시에 나가는 Reranker 호출 수의 한도. 넘치는 요청은 기다리지 않고 벡터 검색 결과로 답합니다.
FAQ_RERANK_MAX_CONCURRENT=32
# 연속으로 이만큼 실패하면 FAQ_RERANK_FAILURE_COOLDOWN 동안 Reranker를 호출하지 않습니다.
FAQ_RERANK_FAILURE_THRESHOLD=5
FAQ_RERANK_FAILURE_COOLDOWN=10s

# 미응답 질문을 같은 그룹으로 묶을 최소 코사인 유사도
UNANSWERED_GROUP_THRESHOLD=0.6

# 미응답 질문 대기열을 꺼내 저장하는 주기(ms)
UNANSWERED_OUTBOX_POLL_DELAY_MS=2000

# 채팅 매장 조회
CHAT_STORE_RADIUS_KM=3.0
CHAT_STORE_LIMIT=5


# ── 외부 API ──────────────────────────────────────────────────
KAKAO_REST_API_KEY=


# ── 랭킹 ──────────────────────────────────────────────────────
RANKING_WINDOW_MINUTES=60
RANKING_SIZE=5
REFRESH_SCHEDULER_INTERVAL_MINUTES=5
MIN_CURRENT_SEARCH_COUNT=20
BASELINE_PERIOD_DAYS=7
BASELINE_MIN_SAMPLE_COUNT=20
TREND_RATIO_THRESHOLD=20

# ── FAQ 모니터링 ──────────────────────────────────────────────────────
FAQ_IMPROVEMENT_LOW_SIMILARITY_THRESHOLD=0.80
FAQ_IMPROVEMENT_LOW_GAP_RATE_THRESHOLD=0.30
FAQ_IMPROVEMENT_UNUSED_DAYS=7
FAQ_IMPROVEMENT_MIN_TOP_K_SAMPLES=20
FAQ_IMPROVEMENT_MIN_TOP1_SAMPLES=20


# ── Backend Image ─────────────────────────────────────────────
# 로컬 Compose 기본 이미지입니다.
# CD에서는 커밋 SHA가 붙은 이미지로 덮어씁니다.
BACKEND_IMAGE=ubot-be:local


# ── Nginx ─────────────────────────────────────────────────────
# /chat/ 게스트 요청 속도 제한
# Authorization Bearer 헤더가 없는 요청에 적용합니다.
CHAT_GUEST_RATE_LIMIT_RATE=30r/m
CHAT_GUEST_RATE_LIMIT_BURST=10

# 로컬에서 프론트와 백엔드를 같은 Nginx로 제공할 때 사용합니다.
WEB_PORT=8088
UBOT_FE_DIST=../UBot-FE/dist


# ── Prometheus ────────────────────────────────────────────────
PROMETHEUS_PORT=19090
# 백엔드를 로컬에서 실행할 때 사용하는 Prometheus HTTP API 주소입니다.
# Docker 배포 환경에서는 Compose가 http://prometheus:9090으로 덮어씁니다.
PROMETHEUS_BASE_URL=http://localhost:19090
PROMETHEUS_CONNECT_TIMEOUT=2s
PROMETHEUS_READ_TIMEOUT=10s
