# ── 실행 환경 선택 ─────────────────────────────────────────────
# 이 묶음으로 Ollama 환경과 vLLM 환경을 고릅니다. 고른 뒤에는 `docker compose up -d` 한 번으로 준비됩니다.
# 환경을 바꿀 때는 먼저 `docker compose down`으로 지금 환경을 내린 뒤에 값을 바꿉니다.
COMPOSE_PATH_SEPARATOR=:

# (1) Ollama 환경 (기본)
COMPOSE_FILE=docker-compose.yml:docker-compose.ollama.yml
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# (2) vLLM 환경: 위 세 줄을 주석으로 바꾸고 아래 네 줄의 주석을 풉니다.
#     프로젝트 이름을 바꿔 DB 볼륨을 따로 씁니다. Ollama로 만든 벡터와 vLLM으로 만든 벡터가 섞이지 않게 하기 위해서입니다.
# COMPOSE_FILE=docker-compose.yml:docker-compose.vllm.yml
# COMPOSE_PROJECT_NAME=ubot-be-vllm
# LLM_PROVIDER=openai-compatible
# EMBEDDING_PROVIDER=openai-compatible

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=ubot
POSTGRES_USER=ubot
POSTGRES_PASSWORD=change-me

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=16379

# ── Ollama 환경 (docker-compose.ollama.yml) ───────────────────
OLLAMA_PORT=11435
OLLAMA_BASE_URL=http://localhost:11435
OLLAMA_EMBEDDING_MODEL=bge-m3:567m
# 채팅 모델 태그. 값이 있으면 ollama-init이 임베딩 모델과 함께 내려받습니다.
OLLAMA_CHAT_MODEL=
# Ollama 임베딩 호출 제한 시간
OLLAMA_CONNECT_TIMEOUT=3s
OLLAMA_READ_TIMEOUT=10s

# ── vLLM 환경 (docker-compose.vllm.yml) ───────────────────────
# 백엔드가 호출할 주소(/v1까지)와 모델 이름(서버의 served model name)
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=ubot-chat
EMBEDDING_BASE_URL=http://localhost:8001/v1
EMBEDDING_MODEL=ubot-embedding
# vLLM 임베딩 호출 제한 시간
EMBEDDING_CONNECT_TIMEOUT=3s
EMBEDDING_READ_TIMEOUT=30s
# vLLM 서버 실행 값. 불러올 모델 등 나머지 값과 설명은 infra/llm/.env.example에 있습니다.
LLM_MAX_MODEL_LEN=4096
VLLM_GPU_MEMORY_UTILIZATION=0.6
VLLM_EMBEDDING_GPU_MEMORY_UTILIZATION=0.2

# ── 답변 생성 공통 ────────────────────────────────────────────
# 두 환경 모두에 적용되는 LLM 호출 제한 시간
LLM_CONNECT_TIMEOUT=3s
LLM_READ_TIMEOUT=120s

# ── 인증 (JWT) ────────────────────────────────────────────────
# 예시: StCQJn4BZq6ZMNMlf0WUM8Py0AW8c3jLTr7nLSqiieo
JWT_SECRET=<base64-encoded-random-secret-at-least-32-bytes>
JWT_ACCESS_TOKEN_EXPIRATION_MILLIS=600000
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=14

# ── 채팅 ──────────────────────────────────────────────────────
CHAT_MAX_ATTEMPTS=3
CHAT_TOP_K=3
CHAT_CONFIDENCE_THRESHOLD=0.75
CHAT_RESPONSE_TIMEOUT_MILLIS=180000
UNANSWERED_GROUP_THRESHOLD=0.6
# 채팅 매장 조회 (반경 km, 최대 개수)
CHAT_STORE_RADIUS_KM=3.0
CHAT_STORE_LIMIT=5

# ── 외부 API ──────────────────────────────────────────────────
KAKAO_REST_API_KEY=

# ── 랭킹 ──────────────────────────────────────────────────────
RANKING_WINDOW_MINUTES=60
RANKING_SIZE=5
REFRESH_SCHEDULER_INTERVAL_MINUTES=5
MIN_CURRENT_SEARCH_COUNT=20
BASELINE_PERIOD_DAYS=7
BASELINE_MIN_SAMPLE_COUNT=20
TREND_RATIO_THRESHOLD=20

# ── Nginx ─────────────────────────────────────────────────────
# 배포 환경의 /chat/ 게스트 요청 속도 제한 (IP 기준. 회원 요청은 제한하지 않음)
CHAT_GUEST_RATE_LIMIT_RATE=30r/m
CHAT_GUEST_RATE_LIMIT_BURST=10
# 로컬에서 프론트와 백엔드를 같은 Nginx로 제공할 때 (docker-compose.web.yml)
WEB_PORT=8088
UBOT_FE_DIST=../UBot-FE/dist

# ── 모니터링 ──────────────────────────────────────────────────
PROMETHEUS_PORT=19090

# ── 기타 ──────────────────────────────────────────────────────
# 이 파일에 적는 것만으로는 프로필이 바뀌지 않습니다. 프로필을 바꾸려면 OS 환경변수로 줍니다.
SPRING_PROFILES_ACTIVE=local
